FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        coturn \
        libsqlite3-0 \
        libstdc++6 \
        openssl \
        python3 && \
    rm -rf /var/lib/apt/lists/*

# All-in-one Flixdesk Server:
# - Web Config Panel & Supervisor on PANEL_PORT (default 9098)
# - crossdesk_server (WSS signaling + /admin dashboard) on 9099
# - coturn (STUN/TURN relay) on 3478 & 50000-60000/udp
COPY --chmod=755 docker/start.sh /start.sh
COPY --chmod=755 docker/generate_certs.sh /docker/generate_certs.sh
COPY --chmod=755 dist/crossdesk_server /crossdesk-server/crossdesk_server
COPY src/admin/web /crossdesk-server/admin
COPY panel /opt/flixdesk-panel

ENTRYPOINT ["python3", "/opt/flixdesk-panel/panel.py"]
